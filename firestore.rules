rules_version = '2';

// 총칼대전 보안 규칙.
//
// **점수·연승·전적은 클라이언트가 못 쓴다.** 게임 서버(Admin SDK)만 쓴다 —
// Admin은 규칙을 건너뛰므로 여기서 막아도 서버는 쓸 수 있다.
// 클라이언트가 쓸 수 있는 건 닉네임과 티켓뿐이다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 값의 모양과 범위를 본다. 터무니없는 값이 들어오는 것만이라도 막는다.
    // **함수는 반드시 service 안에** 있어야 한다 (밖에 두면 문법 오류)
    // 클라이언트가 손댈 수 있는 항목만. **score·streak·record는 없다**
    function mine(d){
      return d.keys().hasOnly(['nick','tk','at','ffa','day','updatedAt'])
        && (!('nick' in d) || (d.nick is string && d.nick.size() <= 16))
        && (!('tk' in d) || (d.tk is int && d.tk >= 0 && d.tk <= 5))
        && (!('ffa' in d) || (d.ffa is int && d.ffa >= 0 && d.ffa <= 3));
    }
    // 고칠 때: 점수 관련 항목을 건드리지 않았는가
    function keepsScore(){
      return !(request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['score','streak','record']));
    }

    match /players/{uid} {
      // 자기 것만
      allow read: if request.auth != null && request.auth.uid == uid;

      // 만들 때: 점수를 담을 수 없다 (서버가 나중에 채운다 — 없으면 1000으로 본다)
      allow create: if request.auth != null && request.auth.uid == uid
                    && mine(request.resource.data);

      // 고칠 때: 점수 관련은 못 건드린다
      allow update: if request.auth != null && request.auth.uid == uid
                    && keepsScore();

      allow delete: if false;
    }

    // 순위표는 누구나 읽고, 쓰는 건 게임 서버(Admin SDK)만.
    // Admin SDK는 규칙을 건너뛰므로 여기서는 전부 막아두면 된다
    match /ranks/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 나머지는 전부 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
